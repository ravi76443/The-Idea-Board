generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Idea {
  id         Int      @id @default(autoincrement())
  text       String
  votes      Int      @default(0)
  created_at DateTime @default(now()) @map("created_at")
  
  @@map("ideas")
}
