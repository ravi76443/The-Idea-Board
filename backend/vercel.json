{
    "version": 2,
    "builds": [
        {
            "src": "./src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/ideas(.*)",
            "dest": "./src/index.ts"
        },
        {
            "src": "/health",
            "dest": "./src/index.ts"
        }
    ]
}